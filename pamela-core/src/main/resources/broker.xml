<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="urn:activemq" xsi:schemaLocation="urn:activemq /schema/artemis-server.xsd">
   <core xmlns="urn:activemq:core">

      <persistence-enabled>false</persistence-enabled>

      <security-enabled>false</security-enabled>

      <acceptors>
         <acceptor name="mqtt">tcp://127.0.0.1:1883?protocols=MQTT</acceptor>
      </acceptors>
   </core>
   
   <security-settings>
    <security-setting match="#">
        <permission type="send" roles="user"/>
        <permission type="consume" roles="user"/>
        <permission type="createNonDurableQueue" roles="user"/>
        <permission type="deleteNonDurableQueue" roles="user"/>
    </security-setting>
</security-settings>

<security-settings>
    <roles>
        <role name="user">
            <permission>send</permission>
            <permission>consume</permission>
        </role>
    </roles>
</security-settings>

